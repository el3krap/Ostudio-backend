
# ==========================================
# OSTUDIO - Git Ignore
# ==========================================

# Dependencies
**/node_modules/

# Environment variables / Secrets
.env
.env.*
!.env.example

# Firebase / Google service accounts
*-firebase-adminsdk-*.json
firebase-service-account.json
serviceAccountKey.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Build output
**/dist/
**/build/

# Runtime / Temporary files
tmp/
temp/

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Local databases
*.sqlite
*.sqlite3

# Docker local files
docker-compose.override.yml

# Project backup
/backend_backup/
